# ============================================
# Environment Variables for Speaking Test
# Copy this file to .env and fill in the values
# ============================================

# JWT Secret Key (MUST CHANGE IN PRODUCTION)
JWT_SECRET_KEY=your-secure-random-string-at-least-32-chars

# CORS Origins (comma-separated)
CORS_ORIGINS=https://your-domain.com

# Frontend URLs
FRONTEND_STUDENT_URL=https://your-domain.com/s
FRONTEND_PARENT_URL=https://your-domain.com/p
FRONTEND_TEACHER_URL=https://your-domain.com

# Qwen API (Required)
QWEN_API_KEY=your-qwen-api-key

# Aliyun OSS (Required)
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=your-bucket-name

# SMTP Email (Optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM_EMAIL=noreply@example.com

# Admin Emails (comma-separated)
ADMIN_EMAILS=admin@example.com
