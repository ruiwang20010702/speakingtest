# ============================================
# AI 口语测评系统 - 环境变量配置示例
# ============================================
# 使用方法：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 根据实际情况填写各项配置
# 3. 注意：.env 文件不会被提交到 Git，请妥善保管
# ============================================

# ============================================
# 应用基础配置
# ============================================
DEBUG=false
# 调试模式：true=开发环境（详细日志、SQL echo），false=生产环境

# ============================================
# 前端地址配置
# ============================================
FRONTEND_STUDENT_URL=http://localhost:3001/s
FRONTEND_PARENT_URL=http://localhost:3000
FRONTEND_TEACHER_URL=http://localhost:3002

# ============================================
# CORS 跨域配置
# ============================================
CORS_ORIGINS=
# CORS 允许的域名列表（逗号分隔）
# 为空时：DEBUG=true 使用开发环境默认域名，DEBUG=false 不允许跨域
# 生产环境示例：CORS_ORIGINS=https://student.domain.com,https://teacher.domain.com

# ============================================
# 测试与认证配置
# ============================================
TEST_EMAIL_WHITELIST=
# 测试邮箱白名单（逗号分隔，需要 ENABLE_TEST_AUTH=true）

ADMIN_EMAILS=
# 管理员邮箱列表（逗号分隔）

USE_MOCK_CRM=false
# CRM Mock 模式：true=使用假数据，false=调用真实 CRM API

ENABLE_TEST_AUTH=false
# 测试认证模式：true=启用魔法验证码 888888 和测试邮箱白名单
# ⚠️ 生产环境必须为 false

ENABLE_TOKEN_REENTRY=false
# 学生入口 Token 重复使用策略
# false=一次性使用（生产环境推荐，防止链接泄露后被滥用）
# true=允许重复进入（仅限测试环境）

# ============================================
# 数据库配置 (PostgreSQL)
# ============================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/speakingtest
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=70

# ============================================
# Redis 配置（用于分布式限流）
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# JWT 认证配置
# ============================================
JWT_SECRET_KEY=your-secret-key-change-in-production
# ⚠️ 生产环境必须更换为安全的随机密钥（建议 32 字节以上）
# 生成方法：openssl rand -hex 32

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Token 过期时间（分钟），1440 = 24 小时

# ============================================
# Cookie 安全配置（httpOnly Cookie 认证）
# ============================================
COOKIE_NAME=access_token
# Cookie 名称

COOKIE_DOMAIN=
# Cookie 域名（为空则使用请求域名）
# 生产环境建议设置主域名，如：.51talk.com（支持子域名共享）

COOKIE_SECURE=true
# 仅 HTTPS 传输
# ⚠️ 生产环境必须为 true，开发环境（HTTP）设为 false

COOKIE_SAMESITE=lax
# SameSite 策略：strict/lax/none
# lax=推荐（兼顾安全和可用性）

COOKIE_PATH=/api
# Cookie 路径（仅 API 请求携带，减少暴露面）

# ============================================
# 讯飞 API 配置（Part1 语音评测）
# ============================================
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=
XUNFEI_MAX_CONCURRENT=50

# ============================================
# 阿里云 Qwen API 配置（Part2 AI 评测）
# ============================================
QWEN_API_KEY=
# ⚠️ 必填：阿里云 DashScope API Key

QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-omni-flash
QWEN_PLUS_MODEL=qwen-plus
QWEN_RPM_LIMIT=60
QWEN_ENABLE_THINKING=true
QWEN_THINKING_BUDGET=2048

# ============================================
# 阿里云 OSS 对象存储配置（音频存储）
# ============================================
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=
# ⚠️ 必填：用于存储学生录音文件

# ============================================
# RabbitMQ 消息队列配置
# ============================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ============================================
# SMTP 邮件配置（验证码发送）
# ============================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=51Talk 口语测评
SMTP_USE_SSL=true
